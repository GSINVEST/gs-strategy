    "not_modeled": ["期貨交易稅", "保證金占用與資金成本", "換月價差", "交易所／期貨商其他費用（exchange_fee 設為 0）"]
  },
  "invariants": [
    { "id": "INV_STATE_CONSISTENT", "label_zh": "狀態名稱與實際部位一致", "expr": "state_predicate_holds", "origin": "code_derived", "enforced_in_code": "unknown", "status": "confirmed", "tlc_profile": "core", "vacuity_note": "IR 自身一致性檢查，不是策略性質。" },
    { "id": "INV_NO_OPPOSITE_POSITION", "label_zh": "同商品不會同時持有反向部位", "expr": "position 為單一帶號淨部位", "origin": "trader_stated", "enforced_in_code": true, "status": "confirmed", "tlc_profile": "core", "kind": "no_opposite_position", "representation": "net_position", "vacuity_note": "淨部位表示法下恆成立，TLC 通過不帶資訊量。TX 與 MTX 是不同商品，彼此可反向（TX 多、MTX 空），程式碼不禁止；若交易員視同一指數為同商品，需明說，再於 aggregate_invariants 加『跨標的淨額』性質。" },
    { "id": "INV_MAX_TRADE_LOSS", "label_zh": "單筆交易（含未實現）虧損不超過總資金 2%", "expr": "|口數| × (entry_pts − price_pts) × 乘數 <= 0.02 × capital_base（逐標的）", "origin": "template_proposed", "enforced_in_code": false, "status": "proposed_needs_human", "tlc_profile": "stress", "vacuity_note": "策略程式沒有停損；2% 是範本建議值，需交易員確認。" }
  ],
  "aggregate_invariants": [
    { "id": "INV_GROSS_LEVERAGE_AT_REBALANCE", "label_zh": "調倉後總名目槓桿不超過 max_gross_leverage（四捨五入與價格變動會造成偏離）",
      "over": "instances", "fn": "sum", "term": "abs(position) * close * $mult", "op": "<=", "rhs": "max_gross_leverage * $equity",
      "holds_at": "after_events", "holds_after": ["REBALANCE"], "origin": "code_derived", "enforced_in_code": "unknown", "status": "confirmed", "tlc_profile": "stress",
      "vacuity_note": "程式碼只在『權重』上保證，口數四捨五入後可能略超。TLA+ 要檢查它需要絕對價格與淨值模型，目前產生器不支援（遇到會拒絕並說明）。" }
  ],
  "stress": [
    { "id": "STRESS_GAP", "label_zh": "開盤跳空", "kind": "gap", "tlc_encoding": "nondeterministic_action", "params": { "gap_points": { "todo": "TODO(人)", "reason": "最大可接受跳空點數由人決定。" } }, "status": "template_default" },
    { "id": "STRESS_CONSECUTIVE_ADVERSE", "label_zh": "連續逆向走勢", "kind": "consecutive_adverse", "tlc_encoding": "nondeterministic_action", "params": { "max_consecutive_bars": { "todo": "TODO(人)", "reason": "連續幾根由人決定。" } }, "status": "template_default", "note": "月調倉策略在兩次調倉之間完全沒有出場機制；逆向走勢可持續整個月。" },
    { "id": "STRESS_LIQUIDITY_ZERO", "label_zh": "流動性歸零", "kind": "liquidity_zero", "tlc_encoding": "nondeterministic_action", "params": { "max_consecutive_bars": { "todo": "TODO(人)", "reason": "持續幾根由人決定。" } }, "status": "template_default" }
  ],
  "open_findings": [
    "ROLL_DUE 每日檢查，但調倉只在月初；兩者同日時的先後與未成交單的交互未實測（同 vgrsi_tx）。",
    "sigma<=0 或資料不足的標的在 _rebalance 被 continue 略過，其既有部位不會被平倉（保持不動）。IR 以 NO_SIGNAL 表示；是否為作者本意待確認。",
    "『有訊號的標的數』進入分母（n_assets），一個標的 NO_SIGNAL 會讓另一個標的權重放大；這是跨標的耦合，per_instrument 機器表達不了。"
  ],
  "out_of_scope": [
    "時間序列動能有沒有預測力、12-1 回看是否合適",
    "target_vol、lookback、skip、vol_com 是不是好參數（參數優化／敏感度）",
    "DSR、PBO、CPCV、成本壓力下的統計有效性（屬 D1 晉升閘門）",
    "回測績效數字、夏普值、樣本外表現",
    "EWMA 波動與口數換算的數值是否正確（訊號為不透明函式）",
    "盤中（tick 內）行為、委託簿、部分成交",
    "保證金追繳、強制平倉、券商與交易所異常",
    "跨標的耦合（歸一化與總槓桿縮放）的數值行為"
  ]
}
