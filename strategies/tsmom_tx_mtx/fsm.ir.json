    { "id": "MTX", "multiplier": 50, "multiplier_unit": "NTD/index_point", "multiplier_source": "strategy.py:POINT_VALUE['MTX']", "tick_size": { "todo": "TODO(人)", "reason": "同上。" } }
  ],
  "data": [
    { "name": "close", "source": "bundle tquant_future，make_continuous_taiwan_futures(['TX','MTX'])（calendar roll、add 調整）", "field": "close", "instrument": "TX,MTX（每個標的各一條）", "frequency": "1d", "adjustment": "add（加法調整，連續合約價）", "available_at": "當根 bar 收盤後（data.history 含當日收盤）", "history_bars": 278 }
  ],
  "constants": [
    { "name": "lookback", "value": 252, "unit": "bars", "source": "config.yaml:params.lookback" },
    { "name": "skip", "value": 21, "unit": "bars", "source": "config.yaml:params.skip" },
    { "name": "vol_com", "value": 60, "unit": "bars", "source": "config.yaml:params.vol_com" },
    { "name": "target_vol", "value": 0.15, "unit": "annualised", "source": "config.yaml:params.target_vol" },
    { "name": "max_gross_leverage", "value": 1.5, "unit": "x portfolio_value", "source": "config.yaml:params.max_gross_leverage" },
    { "name": "allow_short", "value": true, "source": "config.yaml:params.allow_short" },
    { "name": "days_before_close", "value": 10, "unit": "days", "source": "config.yaml:params.days_before_close" },
    { "name": "capital_base", "value": 10000000, "unit": "NTD", "source": "config.yaml:capital_base" }
  ],
  "variables": [
    { "name": "position", "type": "int", "unit": "contracts", "origin": "strategy_code", "per_instance": true, "init": 0,
      "range": { "todo": "TODO(人)", "reason": "口數 = round(權重 × 淨值 ÷ (價格 × 乘數))，程式碼沒有口數硬上限，只有權重層級的 max_gross_leverage。TLA+ 需要一個有限界，必須由人給（或由人同意用 max_gross_leverage ÷ 最低價格推出）。" },
      "source": "strategy.py:_rebalance n_contracts" },
    { "name": "price_pts", "type": "price_points", "unit": "index_points", "origin": "model_only", "per_instance": true, "init": 0,
      "range": { "todo": "TODO(人)", "reason": "同 position，待人決定模型界。" }, "source": "model_only" },
    { "name": "entry_pts", "type": "price_points", "unit": "index_points", "origin": "model_only", "per_instance": true, "init": 0,
      "range": { "todo": "TODO(人)", "reason": "同 position，待人決定模型界。" }, "source": "model_only" }
  ],
  "signals": [
    {
      "id": "tsmom_target",
      "label_zh": "目標口數（波動率目標）",
      "kind": "opaque",
      "impl_ref": { "file": "strategies/tsmom_tx_mtx/strategy.py", "function": "_rebalance（_signed_momentum、_ewma_vol、跨標的歸一與總槓桿縮放後的 n_contracts）" },
      "inputs": ["close"],
      "domain": { "kind": "int_range", "lo": { "todo": "TODO(人)", "reason": "下界＝ position 的 range 下界，待人決定模型界（程式碼無口數硬上限）。" }, "hi": { "todo": "TODO(人)", "reason": "上界同理。" }, "extra_values": ["NO_SIGNAL"] },
      "zone_rule_zh": "每標的符號 = sign(skip 後 lookback 的對數報酬)；大小 = target_vol ÷ EWMA 波動 ÷ 有訊號的標的數，再把總槓桿縮到 max_gross_leverage；換算成口數時四捨五入。標的間經『有訊號的標的數』與『總槓桿縮放』耦合——單一標的機器看不到這個耦合。",
      "tlc_abstraction": "nondeterministic"
    }
  ],
  "states": [
    { "id": "FLAT", "label_zh": "空手", "predicate": "position == 0" },
    { "id": "LONG", "label_zh": "持有多單", "predicate": "position > 0" },
    { "id": "SHORT", "label_zh": "持有空單", "predicate": "position < 0" }
  ],
  "initial_state": "FLAT",
  "events": [
    { "id": "REBALANCE", "label_zh": "月初調倉", "kind": "scheduled", "source": "strategy.py:initialize schedule_function(_rebalance, month_start, market_close)" },
    { "id": "ROLL_DUE", "label_zh": "換月檢查", "kind": "scheduled", "source": "_common/futures_setup.py:make_roll_futures_handler，每日收盤" },
    { "id": "GAP", "label_zh": "跳空", "kind": "adverse", "source": "壓力場景，非策略程式" },
    { "id": "LIQUIDITY_GONE", "label_zh": "流動性歸零（這根下的單成交不了）", "kind": "adverse", "source": "壓力場景，非策略程式" }
  ],
  "transitions": [
    { "id": "T_FLAT_TO_LONG", "label_zh": "空手 → 做多", "from": ["FLAT"], "on": "REBALANCE", "guard": "tsmom_target != NO_SIGNAL and tsmom_target > 0", "to": "LONG",
      "effects": [{ "var": "position", "expr": "tsmom_target" }, { "var": "entry_pts", "expr": "price_pts" }],
      "orders": [{ "instrument": "$self", "kind": "target_position", "target": "tsmom_target", "fills": 1 }], "code_ref": "strategy.py:_rebalance  n_contracts != qty → order_target（instrument 欄於 per_instrument 範圍內代表『該實例的標的』）" },
    { "id": "T_FLAT_TO_SHORT", "label_zh": "空手 → 做空", "from": ["FLAT"], "on": "REBALANCE", "guard": "tsmom_target != NO_SIGNAL and tsmom_target < 0", "to": "SHORT",
      "effects": [{ "var": "position", "expr": "tsmom_target" }, { "var": "entry_pts", "expr": "price_pts" }],
      "orders": [{ "instrument": "$self", "kind": "target_position", "target": "tsmom_target", "fills": 1 }], "code_ref": "同上" },
    { "id": "T_LONG_TO_FLAT", "label_zh": "多單 → 平倉", "from": ["LONG"], "on": "REBALANCE", "guard": "tsmom_target != NO_SIGNAL and tsmom_target == 0", "to": "FLAT",
      "effects": [{ "var": "position", "expr": "0" }],
      "orders": [{ "instrument": "$self", "kind": "target_position", "target": "0", "fills": 1 }], "code_ref": "同上" },
    { "id": "T_LONG_TO_SHORT", "label_zh": "多單 → 一步翻空", "from": ["LONG"], "on": "REBALANCE", "guard": "tsmom_target != NO_SIGNAL and tsmom_target < 0", "to": "SHORT",
      "effects": [{ "var": "position", "expr": "tsmom_target" }, { "var": "entry_pts", "expr": "price_pts" }],
      "orders": [{ "instrument": "$self", "kind": "target_position", "target": "tsmom_target", "fills": 1 }], "code_ref": "同上" },
    { "id": "T_LONG_RESIZE", "label_zh": "多單 → 調整口數", "from": ["LONG"], "on": "REBALANCE", "guard": "tsmom_target != NO_SIGNAL and tsmom_target > 0 and tsmom_target != position", "to": "LONG",
      "effects": [{ "var": "position", "expr": "tsmom_target" }],
      "orders": [{ "instrument": "$self", "kind": "target_position", "target": "tsmom_target", "fills": 1 }], "code_ref": "同上" },
    { "id": "T_SHORT_TO_FLAT", "label_zh": "空單 → 平倉", "from": ["SHORT"], "on": "REBALANCE", "guard": "tsmom_target != NO_SIGNAL and tsmom_target == 0", "to": "FLAT",
      "effects": [{ "var": "position", "expr": "0" }],
      "orders": [{ "instrument": "$self", "kind": "target_position", "target": "0", "fills": 1 }], "code_ref": "同上" },
    { "id": "T_SHORT_TO_LONG", "label_zh": "空單 → 一步翻多", "from": ["SHORT"], "on": "REBALANCE", "guard": "tsmom_target != NO_SIGNAL and tsmom_target > 0", "to": "LONG",
      "effects": [{ "var": "position", "expr": "tsmom_target" }, { "var": "entry_pts", "expr": "price_pts" }],
      "orders": [{ "instrument": "$self", "kind": "target_position", "target": "tsmom_target", "fills": 1 }], "code_ref": "同上" },
    { "id": "T_SHORT_RESIZE", "label_zh": "空單 → 調整口數", "from": ["SHORT"], "on": "REBALANCE", "guard": "tsmom_target != NO_SIGNAL and tsmom_target < 0 and tsmom_target != position", "to": "SHORT",
      "effects": [{ "var": "position", "expr": "tsmom_target" }],
      "orders": [{ "instrument": "$self", "kind": "target_position", "target": "tsmom_target", "fills": 1 }], "code_ref": "同上" },
    { "id": "T_ROLL_LONG", "label_zh": "多單接近到期：平舊月、開新月（口數不變）", "from": ["LONG"], "on": "ROLL_DUE", "guard": "true", "to": "LONG",
      "effects": [], "orders": [{ "instrument": "$self", "kind": "close_and_reopen_on_front", "target": "position", "fills": 2 }], "code_ref": "_common/futures_setup.py:roll_futures" },
    { "id": "T_ROLL_SHORT", "label_zh": "空單接近到期：平舊月、開新月（口數不變）", "from": ["SHORT"], "on": "ROLL_DUE", "guard": "true", "to": "SHORT",
      "effects": [], "orders": [{ "instrument": "$self", "kind": "close_and_reopen_on_front", "target": "position", "fills": 2 }], "code_ref": "_common/futures_setup.py:roll_futures" }
  ],
  "costs": {
    "commission": { "model": "per_contract_per_fill", "per_instrument": { "TX": 200, "MTX": 100 }, "unit": "NTD/contract/fill", "source": "config.yaml:params.per_contract_cost → PerContract(cost=…, exchange_fee=0)" },
    "slippage": {
      "model": "fixed_points", "spread_points": 6.0,
      "adverse_points_per_fill": { "todo": "TODO(人)", "reason": "FixedSlippage(spread=6.0) 是整個價差還是每筆吃一半？以 zipline-tej 實際原始碼為準，本次未查。另外 TX 與 MTX 共用同一個點數，MTX 每點只值 50 元，是否合理未評估（屬成本假設的合理性，不在 TLA+ 範圍）。" },
      "unit": "index_points", "source": "config.yaml:params.spread_points → FixedSlippage(spread=…)"
