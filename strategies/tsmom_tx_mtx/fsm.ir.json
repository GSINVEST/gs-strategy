      { "repo": "gs-strategy", "repo_commit": "6ae4209f656c852917b5664676f87cf3a0835e03", "path": "strategies/tsmom_tx_mtx/config.yaml", "sha256_lf": "591b961d0c258b4e2d4c36f6c822f6e02d209af6736540c818412d1f0b0c3285" },
